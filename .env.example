# ==============================================================================
# KirayaSetu Backend - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SECURITY & HOSTS
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=generate-a-secure-random-secret-key-replace-this
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# OPTION A: Render Native PostgreSQL or Supabase / Neon (RECOMMENDED FOR RENDER)
# Just provide DATABASE_URL. The app will automatically connect via dj-database-url:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# OPTION B: MySQL Cloud (TiDB Cloud Serverless / Aiven / Remote MySQL)
DB_ENGINE=mysql
DB_NAME=kiraya_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=your-mysql-host.com
DB_PORT=3306
DB_SSL_REQUIRE=True

# OPTION C: SQLite (Local development zero-config)
# DB_ENGINE=sqlite
# SQLITE_DB_NAME=db.sqlite3

# ------------------------------------------------------------------------------
# 3. CORS & CSRF (CROSS-ORIGIN SETUP FOR VERCEL)
# ------------------------------------------------------------------------------
# Replace with your actual Vercel app domain (no trailing slash):
CORS_ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-frontend-app.vercel.app,https://*.onrender.com,http://localhost:3000,http://localhost:5173
FRONTEND_URL=https://your-frontend-app.vercel.app

# Cross-domain Cookie Configuration (Vercel Frontend + Render Backend)
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ------------------------------------------------------------------------------
# 4. EMAIL OTP & NOTIFICATIONS (Gmail SMTP / Google Workspace)
# ------------------------------------------------------------------------------
# To test offline in console:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# To send real emails:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-google-app-password
DEFAULT_FROM_EMAIL=KirayaSetu <your-email@gmail.com>

# ------------------------------------------------------------------------------
# 5. OPTIONAL SMS / TWILIO (Leave empty if not using)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_API_KEY=
